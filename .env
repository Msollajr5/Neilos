# ============================================================
# Neilos Partner Portal — Environment Configuration
# ============================================================

# Application
APP_NAME="Neilos Partner Portal"
# APP_URL is commented out to allow access from both localhost and other network PCs dynamically
# APP_URL="http://localhost/Neilos/public"
APP_ENV=production
APP_DEBUG=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neilos_portal
DB_USER=neilosne_tz
DB_PASS=NeilosTZ@2026
DB_CHARSET=utf8mb4

# Session & Security Policies
SESSION_LIFETIME=28800
SESSION_IDLE_TIMEOUT=900
PASSWORD_EXPIRY_DAYS=90
PASSWORD_EXPIRY_WARN_DAYS=14
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Email (SMTP)
SMTP_HOST=mail.neilosnetwork.co.tz
SMTP_PORT=465
SMTP_USER=mail@neilosnetwork.co.tz
SMTP_PASS=Mails@2026
SMTP_SECURE=ssl
SMTP_FROM=mail@neilosnetwork.co.tz
SMTP_FROM_NAME="Neilos Partner Portal"

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx,xlsx,csv

# Currency
USD_TZS_RATE=2500

# SLA Defaults
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72

# Disaster Recovery & Remote Backup (Maisha cPanel Cloud)
DR_BACKUP_ENABLED=true
DR_FTP_HOST=ftp.neilosnetwork.co.tz
DR_FTP_PORT=21
DR_FTP_USER=hamisi@crm.neilosnetwork.co.tz
DR_FTP_PASS=Hamisi@2026
DR_FTP_BASE_DIR=/
DR_RETENTION_HOURLY=12
DR_RETENTION_DAILY=7
DR_RETENTION_WEEKLY=4
DR_RETENTION_MONTHLY=3
